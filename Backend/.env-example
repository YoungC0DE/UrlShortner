PORT=3000
NODE_ENV=development

MONGO_URL=mongodb://localhost:27017
MONGO_DATABASE=url_shortener

# Rate limit for POST /shorten (per client IP; use TRUST_PROXY behind a reverse proxy)
TRUST_PROXY=false
RATE_LIMIT_MAX=20
RATE_LIMIT_TIME_WINDOW_MS=60000

# CORS when the UI is served from another origin (set false only if same-origin)
CORS_ENABLED=true